AIVA_DATABASE_URL=postgresql+asyncpg://aiva_app:aiva_app_dev_only@localhost:15432/aiva
AIVA_ADMIN_DATABASE_URL=postgresql+asyncpg://aiva:aiva_dev_only@localhost:15432/aiva
AIVA_JWT_SECRET=dev-only-jwt-secret-0123456789abcdef
# AES-256-GCM key for encrypting sensitive text at rest (resume text, extracted
# PII, interview answers — see ADR-025). Must be base64 for exactly 32 raw
# bytes. This dev-only value is fine for local/CI; generate a real one for any
# non-dev environment with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
AIVA_ENCRYPTION_KEY=seuo+Ju1ceofY4vl3k+/aGMYyxYQwgrxZpCwFW5HIS0=
AIVA_REDIS_URL=redis://localhost:16379/0
AIVA_MINIO_ENDPOINT=localhost:19000
AIVA_MINIO_ACCESS_KEY=aiva_dev
AIVA_MINIO_SECRET_KEY=aiva_dev_only_change_me
AIVA_MINIO_BUCKET=aiva-artifacts
AIVA_MINIO_SECURE=false
# Real AI inference (recommended): get a key at https://console.anthropic.com/,
# then set ANTHROPIC_API_KEY below and AIVA_GATEWAY_LLM_BACKEND=anthropic.
# Leave both unset/mock for a zero-setup local run — every AI-backed feature
# still works end to end, just against deterministic placeholder output.
ANTHROPIC_API_KEY=
AIVA_GATEWAY_LLM_BACKEND=mock
AIVA_GATEWAY_ANTHROPIC_MODEL=claude-sonnet-5
AIVA_AI_GATEWAY_URL=http://localhost:19100
AIVA_SANDBOX_URL=http://localhost:19200
AIVA_INTERVIEW_TOKEN_HOURS=48
AIVA_LOG_LEVEL=INFO
AIVA_ENVIRONMENT=development
